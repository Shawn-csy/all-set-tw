name = "taiwan-fin-hub"
main = "src/index.ts"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

assets = { directory = "../web/dist", binding = "ASSETS" }
browser = { binding = "BROWSER" }
ai = { binding = "AI", remote = true }

[vars]
DEPLOYMENT_MODE = "local-primary"
LOCAL_DEV_MODE = "true"
# During parallel validation use the dedicated local hostname. After the
# final DNS cutover this may be reduced to https://finance.shawnup.com.
APP_ORIGINS = "https://finance-local.shawnup.com https://finance.shawnup.com"

[triggers]
crons = ["*/10 * * * *"]

[[queues.producers]]
binding = "SYNC_QUEUE"
queue = "taiwan-fin-hub-sync-local"

[[queues.consumers]]
queue = "taiwan-fin-hub-sync-local"
max_batch_size = 1
max_batch_timeout = 1
max_concurrency = 1

[[d1_databases]]
binding = "DB"
database_name = "taiwan-fin-hub"
migrations_dir = "../../packages/db/migrations"
